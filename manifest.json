{
  "manifest_version": 3,
  "name": "EP • 非功快申",
  "version": "1.6",
  "description": "管理并自动填充非功能工作日志到公司系统，实现快速申请",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://oa.epoint.com.cn/*",
    "http://oa.epoint.com.cn/*",
    "https://*.epoint.com.cn/*",
    "http://*.epoint.com.cn/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EP • 非功快申"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://oa.epoint.com.cn/epointprojectm/projectmanage/mission/missionapply/missionapplysplitv2*"
      ],
      "js": ["js/auto-difficulty.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
